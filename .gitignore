__pycache__/
*.pyc

# The virtualenv install.ps1 creates inside the repo (~1GB of wheels).
.venv/

# Runtime logs from start_reachy.ps1 / main.py (per-run diagnostics, and they
# contain transcripts of whatever was said to the robot).
*.log

# Downloaded model weights (~700MB) -- reproducible from the exact URLs/commands
# documented in config.py and body/audio_io.py, not source to track in git.
models/

# SQLite long-term memory DB (runtime state, not source) + WAL/SHM side files.
data/

# Substitute face photos for test_multi_session_simulation.py (photo-substitution
# for face ID, since the mujoco sim has no real human faces). These are real
# people's photos (a placeholder-avatar service, not scraped) -- reproducible
# via the URLs in test_multi_session_simulation.py's docstring, not committed.
test_photos/
