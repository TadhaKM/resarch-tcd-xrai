# Copy this file to ".env" and fill in what you need. .env is gitignored;
# this file is not, so never put a real key in here.
#
#     copy .env.example .env
#
# Everything is optional. With none of it set the robot runs entirely on the
# laptop -- local speech recognition, a local language model, local speech --
# which is what makes it demonstrable in a room with no internet.


# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# Set ONE of these to move the robot's answers to a cloud model. The local
# model stays as the fallback either way, so if the venue's wifi dies
# mid-sentence the robot keeps talking instead of stopping.
#
# This is the single biggest improvement available to it. The local 1.5B model
# has the Hub's facts in front of it and still picks the wrong name out of
# them; a frontier model does not.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Which provider to use. "auto" (the default when unset) uses whichever key is
# present, preferring Anthropic when both are. Set it explicitly to make a
# missing key a loud warning instead of a silent fall back to local, or to
# "ollama" to force offline -- useful when the demonstration IS that it needs
# no internet.
# REACHY_LLM_BACKEND=auto

# The models are chosen in config.py (anthropic_model / openai_model), not
# here, because they are a code decision with a reason attached: both defaults
# favour latency over raw capability, since a spoken reply is judged on how
# quickly it comes back as much as on its wording.


# ---------------------------------------------------------------------------
# Robot connection
# ---------------------------------------------------------------------------
# Only needed when the robot's address is not the one committed in config.py,
# which it usually is not -- it is assigned by whatever network the robot
# joined. start_reachy.ps1 sets both of these for you; set them here to make a
# particular robot the default for this machine.

# REACHY_TARGET=robot_remote
# REACHY_HOST=10.19.17.229

# The daemon's own port. 8000 is what a stock daemon uses; change this only if
# the daemon on the robot was started with --fastapi-port.
# REACHY_DAEMON_PORT=8000
